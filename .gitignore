##############################
# CBS_FUSION super-repo ignore
##############################

# ---- catkin / ROS workspaces ----
**/build/
**/devel/
**/install/
**/logs/
**/.catkin_tools/

# ---- GTSAM local build/install ----
gtsam/build/
gtsam/install/

# ---- pixi / python / caches ----
.pixi/
__pycache__/
**/__pycache__/
*.pyc
.cache/
**/.cache/
.ccache/
**/.ccache/

# ---- datasets / bags / large data ----
datasets/
**/datasets/
*.bag
*.db3
*.mcap
*.pcd
*.ply
*.bin
*.npz
*.npy
*.csv
*.h5
*.hdf5

# ---- binaries / build outputs ----
*.o
*.obj
*.a
*.so
*.so.*
*.dylib
*.dll
*.exe
*.out

# ---- IDE / editor ----
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# ---- misc ----
tmp/
**/tmp/
*.log

# cloned dependency repos (tracked via forks + REPOS.lock, not committed here)
kimera_ws/
cbs_ws/
gtsam/
# --- Kimera vocabulary files (downloaded at build time; do not commit) ---
vocabulary/ORBvoc.yml
vocabulary/ORBvoc.zip
vocabulary/ORBvoc/
