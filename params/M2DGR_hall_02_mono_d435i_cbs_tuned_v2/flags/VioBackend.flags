#!/bin/bash
--debug_graph_before_opt=false
--process_cheirality=true
--max_number_of_cheirality_exceptions=5
--compute_state_covariance=true

# Standalone (no CBS): CBS optimizer + external belief queues can keep extra graphs/values alive.
--use_cbs_optimizer=false

# zy CBS tuned v2 profile for M2DGR:
# widen timestamp/age gates so fixed-lag matching can survive cross-stack delay.
--external_prior_timestamp_tolerance_ns=1500000000
--external_prior_max_future_lead_ns=1000000000
--external_prior_max_age_ns=30000000000
--external_prior_max_queue_size=500
--external_prior_queue_time_horizon_ns=30000000000
--external_prior_max_per_optimize=6
--external_pose_belief_safe_covariance_fallback=true

# Keep legacy behavior.
--no_incremental_pose=true
--cbs_replace_fixed_lag_optimizer=false
